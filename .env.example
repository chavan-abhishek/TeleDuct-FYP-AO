# ==============================================================================
# TeleDuct Environment Configuration Template
# Copy this file to .env and adjust values for your local / cloud environment.
# DO NOT commit real secrets or production credentials to git.
# ==============================================================================

# ── Local Hub / PostgreSQL Configuration ──
POSTGRES_USER=teleduct_admin
POSTGRES_PASSWORD=teleduct_secure_pass_2026
POSTGRES_DB=teleduct_telemetry
POSTGRES_PORT=5432

# ── OpenTelemetry Collector & Prometheus ──
OTEL_HTTP_PORT=4318
OTEL_GRPC_PORT=4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ── Telemetry Emitter Endpoints (Remote GPU -> Local Hub) ──
# For local testing, use http://localhost:4318
# For remote GPU via ngrok, use https://<YOUR_SUBDOMAIN>.ngrok-free.app
OTEL_ENDPOINT=http://localhost:4318

# For local testing, use postgresql://teleduct_admin:teleduct_secure_pass_2026@localhost:5432/teleduct_telemetry
# For remote GPU via ngrok, use postgresql://teleduct_admin:teleduct_secure_pass_2026@0.tcp.ngrok.io:<PORT>/teleduct_telemetry
PG_DSN=postgresql://teleduct_admin:teleduct_secure_pass_2026@localhost:5432/teleduct_telemetry

# ── SGLang Inference Engine ──
SGLANG_URL=http://localhost:18000
